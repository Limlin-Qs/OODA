NODE_ENV=development
HOST=127.0.0.1
PORT=4016
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/sharework
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:4016/auth/callback
# 引导管理员：逗号分隔的 OIDC subject 列表，命中的身份登录时自动成为管理员。
# 用于首个管理员引导和“无可用管理员”恢复；每次提升都会写入审计。
BOOTSTRAP_ADMIN_SUBJECTS=
