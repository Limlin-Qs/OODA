{
  "name": "sharework_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/src/main.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "lint": "eslint .",
    "migrate": "npm run build:server && node server-dist/server/src/migrate.js",
    "preview": "vite preview",
    "start:server": "npm run build:server && node server-dist/server/src/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && npm run build:server && node e2e/run.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.0"
  }
}
